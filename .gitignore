# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ansible sensitive or environment-specific files
hosts
inventory
*.vault
group_vars/*.yml
group_vars/*.yaml
host_vars/*.yml
host_vars/*.yaml
variables.yaml
variables.yml
secrets.yaml
secrets.yml

# Encrypted files (just in case)
*.age
*.gpg

# Ansible retry files
*.retry

# Ignore private SSH keys or similar
*.pem
*.key
*.crt

# Ignore output and temporary files
*.log
*.tmp
*.bak

# Ignore Python cache (common in Ansible environments)
__pycache__/
*.pyc
*.pyo

# Ignore virtual environments
.venv/
env/
venv/

# Ignore molecule test output (if used)
.molecule/

# Ignore roles downloaded via ansible-galaxy
roles/*/
!roles/requirements.yml
